{
  "name": "esm-imports",
  "version": "1.0.0",
  "type": "module",
  "exports": "./src/index.js",
  "imports": {
    "#plain": "./src/vendor/plain.js",
    "#conditional": {
      "node": "./src/vendor/node.js",
      "default": "./src/vendor/browser.js"
    },
    "#internal/*": "./src/internal/*.js",
    "#internal/exact": "./src/vendor/exact.js",
    "#tie/*": "./src/tie/short/*",
    "#tie/*.js": "./src/tie/long/*.js",
    "#array": [{ "browser": "./src/vendor/browser.js" }, "./src/vendor/array.js"],
    "#bare": "bare-target",
    "#path": { "node": "path", "default": "./src/vendor/browser.js" }
  }
}
